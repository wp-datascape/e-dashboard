  "definitions": {
    "title": "Key Definitions",
    "activeCustomer": {
      "term": "Active Customer",
      "def": "last_transaction_date ≥ period start − {{months}} months"
    },
    "existingCustomer": {
      "term": "Existing Customer",
      "def": "first_transaction_date < period start"
    },
    "newCustomer": {
      "term": "New Customer",
      "def": "first_transaction_date within this period"
    },
    "dormantCustomer": {
      "term": "Dormant Customer",
      "def": "last_transaction_date < period start − 3 months (default)"
    },
    "productCategory": {
      "term": "Product Category",
      "def": "Hardware + Consumable only — services are not counted"
    },
    "highMarginProduct": {
      "term": "High Margin Product",
      "def": "product_categories.is_high_margin = true"
    }
  }
