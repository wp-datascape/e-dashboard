# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://dashboard:dashboard123@localhost:5432/e_dashboard

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CSRF
CSRF_SECRET=your-csrf-secret-key-change-in-production

# CORS
CORS_ORIGIN=http://localhost:5173

# Upload
UPLOAD_MAX_SIZE_MB=10

# Encryption (min 32 characters)
CREDENTIALS_ENCRYPTION_KEY=change-this-to-a-secret-key-min-32-chars!

# Account Lockout (Task002 Task C)
ACCOUNT_LOCKOUT_THRESHOLD=5
ACCOUNT_LOCKOUT_DURATION_MINUTES=30
